<!DOCTYPE html>
<html><head><meta charset="utf-8"><meta http-equiv="x-ua-compatible" content="ie=edge">
<title>MultiTool Launcher — установка</title>
<hta:application id="app" applicationname="MultiTool Setup" border="none" caption="no" scroll="no" showintaskbar="yes" singleinstance="yes" contextmenu="no">
<style>
html,body{margin:0;padding:0;width:780px;height:480px;overflow:hidden;background:#1d1d1d;font-family:"Segoe UI",Tahoma,sans-serif;color:#eee;font-size:14px}
#bar{position:absolute;left:0;top:0;width:780px;height:34px;background:#111;border-bottom:3px solid #000;cursor:move}
#bar b{position:absolute;left:14px;top:9px;font:bold 11px Consolas,"Courier New",monospace;letter-spacing:2px;color:#9a9a9a}
#x{position:absolute;right:0;top:0;width:44px;height:31px;text-align:center;line-height:31px;color:#ccc;cursor:pointer;font:bold 14px Consolas}
#x:hover{background:#c0392b;color:#fff}
#L{position:absolute;left:0;top:34px;width:300px;height:446px;background:#78b8f0}
#art{position:absolute;left:0;top:0}
#ic{position:absolute;left:98px;top:146px;-ms-animation:bob 1.4s steps(4) infinite alternate;animation:bob 1.4s steps(4) infinite alternate}
@keyframes bob{to{top:134px}}
#R{position:absolute;left:300px;top:34px;width:480px;height:446px;background:#262626;border-left:4px solid #000}
.pg{position:absolute;left:36px;top:30px;width:410px;display:none;animation:in .35s steps(6)}
@keyframes in{from{opacity:0;margin-left:24px}}
h1{margin:0 0 10px;font:bold 22px/1.25 Consolas,"Courier New",monospace;letter-spacing:2px;color:#fff;text-shadow:3px 3px #000}
h2{margin:0 0 14px;font:bold 17px Consolas,"Courier New",monospace;letter-spacing:2px;color:#fff;text-shadow:2px 2px #000}
p{margin:0 0 14px;color:#bdbdbd;line-height:1.5}
.splash{display:inline-block;color:#ffe94d;font:bold 12px Consolas,monospace;text-shadow:2px 2px #3d3a00;-ms-transform:rotate(-4deg);transform:rotate(-4deg);margin-bottom:16px;animation:pl .5s steps(2) infinite alternate}
@keyframes pl{to{transform:rotate(-4deg) scale(1.12)}}
.b{display:inline-block;margin-right:10px;padding:12px 20px;font:bold 12px Consolas,"Courier New",monospace;letter-spacing:1px;color:#fff;background:#6e6e6e;border:3px solid;border-color:#b8b8b8 #353535 #353535 #b8b8b8;text-shadow:2px 2px #3a3a3a;cursor:pointer}
.b:hover{background:#7d7d7d;color:#ffffa0}
.g{background:#4aa02c;border-color:#98ee78 #1b4d0f #1b4d0f #98ee78}.g:hover{background:#58b536;color:#fff}
input[type=text]{width:100%;padding:10px;background:#000;color:#fff;border:3px solid;border-color:#2a2a2a #707070 #707070 #2a2a2a;font:13px Consolas,monospace;outline:none;box-sizing:border-box}
label{display:block;margin:0 0 10px;color:#ddd;cursor:pointer}
.fr{display:flex;gap:8px;margin:0 0 6px}.fr .b{margin:0;padding:9px 12px;flex:none}.nt{color:#8a8a8a;font:12px Consolas,monospace;margin:0 0 14px;min-height:15px}.lb2{margin:0 0 6px;color:#ddd}#perr{color:#ff7b7b;margin:6px 0 0;min-height:18px}
.xp{height:20px;background:#111;border:3px solid #000;margin:18px 0 14px}
#fill{height:100%;width:0;background:repeating-linear-gradient(90deg,#8ee83f 0px,#8ee83f 10px,#58a428 10px,#58a428 12px);background-size:12px 100%;animation:mv .7s linear infinite}
@keyframes mv{to{background-position:12px 0}}
.st{color:#777;margin:0 0 6px;font:13px Consolas,monospace}.st.ok{color:#9bf27a}
#err{color:#ff7b7b}
</style></head>
<body>
<div id="bar"><b>MULTITOOL LAUNCHER · SETUP</b><div id="x" onclick="window.close()">X</div></div>
<div id="L"><canvas id="art" width="300" height="446"></canvas><img id="ic" width="104" height="104" src="data:image/png;base64,"></div>
<div id="R">
 <div class="pg" id="p1"><div class="splash">Копай глубже!</div><h1>MULTITOOL<br>LAUNCHER</h1>
  <p>Лаунчер Minecraft: Vanilla, Fabric, Quilt, Forge, моды, скины, лобби для игры с друзьями и автообновления. Папки для лаунчера и игры выберешь на следующем шаге.</p>
  <div class="b g" onclick="page(2)">УСТАНОВИТЬ &rarr;</div></div>
 <div class="pg" id="p2" style="top:22px"><h2>ПАРАМЕТРЫ</h2>
  <div class="lb2">Куда поставить лаунчер:</div><div class="fr"><input type="text" id="dir" onchange="info()"><div class="b" onclick="browse('dir','MultiTool Launcher')">ОБЗОР…</div></div><div class="nt" id="n1"></div>
  <div class="lb2">Папка игры (.minecraft — версии, моды, миры):</div><div class="fr"><input type="text" id="gdir" onchange="info()"><div class="b" onclick="browse('gdir','.minecraft')">ОБЗОР…</div></div><div class="nt" id="n2"></div>
  <label><input type="checkbox" id="c1" checked> Ярлык на рабочем столе</label>
  <label><input type="checkbox" id="c2" checked> Ярлык в меню «Пуск»</label>
  <div id="perr"></div>
  <div style="height:6px"></div><div class="b" onclick="page(1)">&larr; НАЗАД</div><div class="b g" onclick="go()">ПОЕХАЛИ</div></div>
 <div class="pg" id="p3"><h2>УСТАНОВКА…</h2><div class="xp"><div id="fill"></div></div>
  <div class="st" id="s1">□ Распаковка файлов</div><div class="st" id="s2">□ Ярлыки</div><div class="st" id="s3">□ Регистрация в системе</div><p id="err"></p></div>
 <div class="pg" id="p4"><div class="splash">Готово!</div><h1>ВСЁ<br>ГОТОВО</h1><p>Лаунчер установлен. Версии и моды можно ставить прямо внутри.</p>
  <label><input type="checkbox" id="c3" checked> Запустить лаунчер</label><div style="height:10px"></div>
  <div class="b g" onclick="fin()">ЗАКРЫТЬ</div></div>
</div>
<script language="JScript">
var PAY='';
var sh=new ActiveXObject('WScript.Shell'),fso=new ActiveXObject('Scripting.FileSystemObject');
function $(i){return document.getElementById(i)}
window.resizeTo(780,480);window.moveTo((screen.width-780)/2,(screen.height-480)/2);
function sc(c,s){var g=c.getContext('2d'),W=Math.floor(c.width/s),H=Math.floor(c.height/s),z=7;
function r(){z=(z*1664525+1013904223)%4294967296;return z/4294967296}
function px(x,y,w,h,k){g.fillStyle=k;g.fillRect(x*s,y*s,w*s,h*s)}
function nz(x,y,w,h,a){for(var j=0;j<h;j++)for(var i=0;i<w;i++)px(x+i,y+j,1,1,a[Math.floor(r()*a.length)])}
var gy=Math.floor(H*.64),i;
px(0,0,W,H,'#78b8f0');px(0,0,W,Math.floor(H*.28),'#5fa4e6');px(0,Math.floor(H*.28),W,Math.floor(H*.2),'#6aaeea');
px(W-14,5,7,7,'#fff2a0');px(W-13,6,5,5,'#ffe14d');
function cl(x,y){px(x,y,11,3,'#fff');px(x+2,y-2,6,2,'#fff');px(x+1,y+3,8,1,'#dbe9f5')}
cl(5,12);cl(36,24);cl(18,36);
for(i=0;i<W;i++){var h=3+Math.floor(3*Math.sin(i/4)+2*Math.sin(i/9));px(i,gy-h,1,h,'#4a8f35')}
nz(0,gy,W,2,['#5da130','#68b836','#4e8f27']);nz(0,gy+2,W,7,['#7a5230','#6b4528','#855a36','#5e3d22']);nz(0,gy+9,W,H-gy-9,['#7d7d7d','#707070','#868686','#6a6a6a']);
for(i=0;i<7;i++){px(Math.floor(r()*W),gy+10+Math.floor(r()*(H-gy-12)),1,1,i%3?'#2a2a2a':'#e8c33a')}
var T=[10,48];for(i=0;i<T.length;i++){px(T[i],gy-8,2,8,'#6b4a2b');nz(T[i]-3,gy-14,8,7,['#3f7d20','#4a8f27','#357019'])}}
sc($('art'),6);
var dir=sh.ExpandEnvironmentStrings('%LOCALAPPDATA%')+'\\MultiTool Launcher',gdef=sh.ExpandEnvironmentStrings('%APPDATA%')+'\\.minecraft';$('dir').value=dir;$('gdir').value=gdef;
function q(t){return t.replace(/'/g,"''")}
function trim(t){return t.replace(/^\s+|\s+$/g,'').replace(/\\+$/,'')}
function browse(id,sub){try{var f=new ActiveXObject('Shell.Application').BrowseForFolder(0,'Выбери папку',0x51,0);
 if(f&&f.Self&&f.Self.Path){var p=trim(f.Self.Path);if(p.toLowerCase().lastIndexOf(sub.toLowerCase())!==p.length-sub.length||p.length<sub.length)p=p+'\\'+sub;$(id).value=p;info()}}catch(e){}}
function chk(p){if(!/^[A-Za-z]:\\/.test(p))return 'Укажи полный путь, например D:\\Games\\MultiTool';
 try{if(!fso.DriveExists(fso.GetDriveName(p)))return 'Диск '+fso.GetDriveName(p)+' не найден'}catch(e){return 'Неверный путь'}return ''}
function free(p){try{var d=fso.GetDrive(fso.GetDriveName(p));return 'Свободно на диске: '+Math.floor(d.FreeSpace/1073741824*10)/10+' ГБ'}catch(e){return ''}}
function info(){var a=trim($('dir').value),b=trim($('gdir').value);$('n1').innerText=chk(a)||free(a);$('n2').innerText=chk(b)||free(b)+' (нужно 1–10 ГБ)'}info();
function page(n){for(var i=1;i<=4;i++)$('p'+i).style.display=(i==n)?'block':'none'}page(1);
var drag=false,dx=0,dy=0;
$('bar').onmousedown=function(){drag=true;dx=window.event.screenX-window.screenLeft;dy=window.event.screenY-window.screenTop};
document.onmousemove=function(){if(drag)window.moveTo(window.event.screenX-dx,window.event.screenY-dy)};document.onmouseup=function(){drag=false};
function lnk(p,d){var s=sh.CreateShortcut(p);s.TargetPath=sh.ExpandEnvironmentStrings('%WINDIR%')+'\\System32\\wscript.exe';s.Arguments='"'+d+'\\launch.vbs"';s.WorkingDirectory=d;s.IconLocation=d+'\\icon.ico';s.Description='MultiTool Launcher';s.Save()}
var pct=0,tm=null,flag='',D2='';
var G2='';
function go(){
 D2=trim($('dir').value);G2=trim($('gdir').value);var e=chk(D2)||chk(G2);if(!e&&/\\Program Files/i.test(D2))e='В Program Files нужны права администратора — выбери другую папку';if(e){$('perr').innerText=e;return}$('perr').innerText='';
 page(3);pct=3;$('fill').style.width='3%';
 try{
  var tp=sh.ExpandEnvironmentStrings('%TEMP%'),tmp=tp+'\\mt-payload.zip',b64=tp+'\\mt-payload.b64';
  var ts=fso.CreateTextFile(b64,true,false);ts.Write(PAY);ts.Close();
  flag=D2+'\\.installed';
  var Dq=q(D2),cmd='powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command "[IO.File]::WriteAllBytes(\''+q(tmp)+'\',[Convert]::FromBase64String([IO.File]::ReadAllText(\''+q(b64)+'\'))); New-Item -ItemType Directory -Force -Path \''+Dq+'\' | Out-Null; Remove-Item \''+q(flag)+'\' -ErrorAction SilentlyContinue; Expand-Archive -LiteralPath \''+q(tmp)+'\' -DestinationPath \''+Dq+'\' -Force; New-Item -ItemType File -Force -Path \''+q(flag)+'\' | Out-Null"';
  sh.Run(cmd,0,false);
 }catch(e){$('err').innerText='Ошибка: '+e.message;return}
 var t0=new Date().getTime();
 tm=setInterval(function(){
  pct+=(88-pct)*0.06;$('fill').style.width=Math.round(pct)+'%';
  if(fso.FileExists(flag)){clearInterval(tm);finish()}
  else if(new Date().getTime()-t0>90000){clearInterval(tm);$('err').innerText='Не удалось распаковать файлы (нужен PowerShell 5 / Windows 10+).'}
 },200)}
function finish(){
 $('s1').className='st ok';$('s1').innerText='■ Распаковка файлов';$('fill').style.width='94%';
 try{
  if(G2.toLowerCase()!==gdef.toLowerCase()){var gf=fso.CreateTextFile(D2+'\\gamedir.txt',true,true);gf.Write(G2);gf.Close()}else if(fso.FileExists(D2+'\\gamedir.txt')){fso.DeleteFile(D2+'\\gamedir.txt')}
  if($('c1').checked)lnk(sh.SpecialFolders('Desktop')+'\\MultiTool Launcher.lnk',D2);
  if($('c2').checked)lnk(sh.SpecialFolders('Programs')+'\\MultiTool Launcher.lnk',D2);
  $('s2').className='st ok';$('s2').innerText='■ Ярлыки';
  var k='HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\MultiToolLauncher\\';
  sh.RegWrite(k+'DisplayName','MultiTool Launcher','REG_SZ');sh.RegWrite(k+'DisplayIcon',D2+'\\icon.ico','REG_SZ');
  sh.RegWrite(k+'InstallLocation',D2,'REG_SZ');sh.RegWrite(k+'DisplayVersion','1.4.0','REG_SZ');
  sh.RegWrite(k+'UninstallString','wscript.exe "'+D2+'\\uninstall.vbs"','REG_SZ');
  var pk='HKCU\\Software\\Classes\\multitool\\';sh.RegWrite(pk,'URL:MultiTool Launcher','REG_SZ');sh.RegWrite(pk+'URL Protocol','','REG_SZ');sh.RegWrite(pk+'shell\\open\\command\\','wscript.exe "'+D2+'\\launch.vbs" "%1"','REG_SZ');
  $('s3').className='st ok';$('s3').innerText='■ Регистрация в системе';
 }catch(e){$('err').innerText='Ярлыки не созданы: '+e.message}
 $('fill').style.width='100%';setTimeout(function(){page(4)},600)}
function fin(){if($('c3').checked)sh.Run('wscript.exe "'+D2+'\\launch.vbs"',1,false);window.close()}
</script></body></html>
